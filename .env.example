# 运行前复制为 .env，并改为仅自己掌握的强随机值。
AUTH_SECRET=replace-with-a-long-random-server-secret
AUTH_TOKEN_SECRET=replace-with-a-different-long-random-token-secret
SEED_PASSWORD=replace-with-a-non-production-demo-password
APP_PORT=8000
EMBEDDING_BASE_URL=https://your-openai-compatible-provider.example/v1
EMBEDDING_API_KEY=replace-with-an-embedding-api-key
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_DIM=1536
# 复用上述 OpenAI 兼容网关和 API 密钥；不填写时应用默认使用此模型。
CHAT_MODEL=doubao-seed-2-1-lite-260915
# 主应用和同仓 mcp-demo 共用此令牌；请使用新的强随机值。
MCP_AUTH_TOKEN=replace-with-a-strong-mcp-bearer-token
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-mysql-root-password
